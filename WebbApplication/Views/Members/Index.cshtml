@model MembersIndexViewModel

@{
    ViewData["Title"] = "Members";
    Layout = "_PortalLayout";
}

<div id="members">
    <div class="members-header">
        <h1>Members</h1>
        
        @if (User.IsInRole("Admin"))
        {
            <button type="button" class="btn btn-blue btn-add" data-type="modal" data-target="#addMemberModal">
                <i class="fa-duotone sa-solid fa-plus"></i>
                <span>Add Member</span>
            </button>
        }
        
    </div>

    <form class="list-selection" method="get">
        <label>Items:</label>
        <select name="pageSize" id="pageSize" onchange="this.form.submit()">
            @foreach (var size in Model.PageSizeOptions)
            {
                if (size == Model.PageSize)
                {
                    <option value="@size" selected>@size</option>
                }
                else
                {
                    <option value="@size">@size</option>
                }
            }
        </select>
        <noscript>
            <button type="submit" class="btn">Update</button>
        </noscript>
    </form>

    <section id="member-list">
        @if (Model.Members != null && Model.Members.Any())
        {
            foreach (var member in Model.Members)
            {
                @await Html.PartialAsync("Partials/Lists/_MembersListPartial", member)

                var updateModal = Model.UpdateMemberViewModels.FirstOrDefault(p => p.Id == member.Id);

                if (updateModal != null)
                {
                    @await Html.PartialAsync("Partials/Modals/_UpdateMemberModal", updateModal)
                }
            }
        }
    </section>

    <div class="pagination-wrapper">
        <div class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <a asp-controller="Members" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize"><i class="fa-solid fa-chevron-left"></i></a>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <span>@i</span>
                }
                else
                {
                    <a asp-controller="Members" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                }
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-controller="Members" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize"><i class="fa-solid fa-chevron-right"></i></a>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("Partials/Modals/_AddMemberModal", Model.AddMemberFormData)

