@model AddClientViewModel

<section id="addClientModal" class="modal">
    <div class="modal-card">
        <div class="card-header modal-header">
            <h3>Add Client</h3>
            <button data-type="close" data-target="#addClientModal" class="btn-close"></button>
        </div>
        <div class="card-body">
            <form class="modal-form" asp-action="AddClient" method="post" enctype="multipart/form-data">

                <div class="form-group">
                    <label asp-for="ClientName" class="form-label"></label>
                    <input asp-for="ClientName" class="form-input" placeholder="Client name" />
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-input" placeholder="Your email address" />
                </div>
                
                <button type="submit" class="btn btn-blue btn-modal">Add Client</button>
            </form>
        </div>
    </div>
</section>