@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var firstName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? "User";
    var lastName = User.FindFirst(ClaimTypes.Surname)?.Value ?? "";
    var imageUrl = User.FindFirst("UserImage")?.Value ?? "/images/avatar.svg";
}

<div id="account-container">
    <button type="button" data-type="dropdown" data-target="#account-dropdown" class="btn-account">
        <img src="@imageUrl" alt="Account avatar">
    </button>

    <div id="account-dropdown" class="dropdown">
        <div class="dropdown-header">
            <div class="account-name">
                <img src="@imageUrl" alt="Account avatar">
                <span>@firstName @lastName</span>
            </div>
        </div>

        <div class="dropdown-body">
            <div class="darktoggle-container">
                <div class="toggle-label">
                    <i class="fa-duotone fa-solid fa-cog"></i>
                    <span>Dark Mode</span>
                </div>
                <label class="switch">
                    <input type="checkbox" id="darkModeToggle" data-type="toggle" data-func="darkmode">
                    <span class="slider"></span>
                </label>
            </div>

            <div class="divider account-divider"></div>

            <form asp-controller="Auth" asp-action="LogOut" method="post" class="logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-action">
                    <i class="fa-duotone fa-solid fa-right-from-bracket"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </div>
</div>