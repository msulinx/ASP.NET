<div id="cookieModal" class="cookie-modal">
    <div class="card">
        <div class="content">
            <h3>Manage Your Privacy Settings </h3>
            <p>We and our partners use cookies to collect information for various purposes,
                including personalizing content and ads, analyzing traffic, and enabling site functionality.</p>
            <p>By clicking "Accept", you consent to the use of cookies for all purposes. You can also customize your 
                preferences by selecting which purposes you consent to and clicking "Save selected settings"</p>
            <p>You can withdraw your consent at any time by clicking the privacy settings icon in the bottom left corner of the page</p>
            <p>Learn more about how we use cookies and manage personal data by clicking the link below</p>
            <p><a href="#">Read more here</a></p>
        </div>
        <form id="cookieConsentForm" class="settings">
            <h4>Cookies</h4>
            <div class="options">
                
                <div class="option">
                    <label class="switch-label" for="cookieEssential">
                        <i class="fa-solid fa-chevron-down"></i>
                        Essential (always active)
                    </label>
                    <label class="switch">
                        <input type="checkbox" id="cookieEssential" name="essential" checked disabled>
                        <span class="slider round"></span>
                    </label>
                </div>

                <div class="option">
                    <label class="switch-label" for="cookieFunctional">
                        <i class="fa-solid fa-chevron-down"></i>
                        Functional
                    </label>
                    <label class="switch">
                        <input type="checkbox" id="cookieFunctional" name="functional">
                        <span class="slider round"></span>
                    </label>
                </div>

                <div class="option">
                    <label class="switch-label" for="cookieAnalytics">
                        <i class="fa-solid fa-chevron-down"></i>
                        Analytics & Statistics
                    </label>
                    <label class="switch">
                        <input type="checkbox" id="cookieAnalytics" name="analytics">
                        <span class="slider round"></span>
                    </label>
                </div>

                <div class="option">
                    <label class="switch-label" for="cookieMarketing">
                        <i class="fa-solid fa-chevron-down"></i>
                        Marketing
                    </label>
                    <label class="switch">
                        <input type="checkbox" id="cookieMarketing" name="marketing">
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>
            <div class="cookie-buttons">
                <button type="button" class="btn btn-dark" onclick="acceptAll()">Accept All</button>
                <button type="button" class="btn btn-dark-outline" onclick="acceptSelected()">Save Selected Settings</button>
            </div>
        </form>
    </div>
</div>
<div class="cookieConsentIcon" onclick="showCookieModal()">
    <i class="fa-solid fa-cookie-bite"></i>
</div>
