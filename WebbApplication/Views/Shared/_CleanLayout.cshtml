<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] Alpha Portal</title>

    <!-- Icons -->
    <script src="https://kit.fontawesome.com/a576612222.js" crossorigin="anonymous"></script>
    
    <!-- Bootstrap & CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
</head>
<body>

@RenderBody()
@await Html.PartialAsync("Partials/Components/_CookieConsentPartial")
<script src="~/js/components/validate.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
<script src="~/js/components/cookie-consent.js" asp-append-version="true"></script>
</body>
</html>