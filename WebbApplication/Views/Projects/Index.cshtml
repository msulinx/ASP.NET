@model ProjectsIndexViewModel
@using System.Linq


@{
    ViewData["Title"] = "Projects";
    Layout = "_PortalLayout";
}


<div id="projects">
    <div class="project-header">
        <h1>Projects</h1>
        <button type="button" class="btn btn-blue btn-add" data-type="modal" data-target="#addProjectModal">
            <i class="fa-duotone sa-solid fa-plus"></i>
            <span>Add Project</span>
        </button>
    </div>
    <div class="project-menu">
        @await Html.PartialAsync("Partials/Components/_ProjectStatusPartial")
    </div>

    <form class="list-selection" method="get">
        <input type="hidden" name="page" value="1" />
        <label>Items:</label>
        <select name="pageSize" id="pageSize" onchange="this.form.submit()">
            @foreach (var size in Model.PageSizeOptions)
            {
                if (size == Model.PageSize)
                {
                    <option value="@size" selected>@size</option>
                }
                else
                {
                    <option value="@size">@size</option>
                }
            }
        </select>
        <noscript>
            <button type="submit" class="btn">Update</button>
        </noscript>
    </form>
    
</div>

<section id="project-list">
    @if (Model.Projects != null && Model.Projects.Any())
    {
        foreach (var project in Model.Projects)
        {
            @await Html.PartialAsync("Partials/Lists/_ProjectsListPartial", project)

            var updateModal = Model.UpdateProjectViewModels.FirstOrDefault(p => p.Id == project.Id);

            if (updateModal != null)
            {
                @await Html.PartialAsync("Partials/Modals/_UpdateProjectModal", updateModal)
            }
        }
    }
</section>

<div class="pagination-wrapper">
    <div class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <a asp-controller="Projects" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize"><i class="fa-solid fa-chevron-left"></i></a>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            if (i == Model.CurrentPage)
            {
                <span>@i</span>
            }
            else
            {
                <a asp-controller="Projects" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
            }
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a asp-controller="Projects" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize"><i class="fa-solid fa-chevron-right"></i></a>
        }
    </div>
</div>

@await Html.PartialAsync("Partials/Modals/_AddProjectModal", Model.AddProjectFormData)